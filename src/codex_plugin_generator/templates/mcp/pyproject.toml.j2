[project]
name = "{{ name }}"
version = "0.1.0"
description = "{{ description }}"
authors = [
    {name = "{{ author }}"{% if email %}, email = "{{ email }}"{% endif %}}
]
readme = "README.md"
requires-python = ">=3.9"
dependencies = [
    "mcp>=0.1.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.0",
    "pytest-asyncio>=0.21",
    "black>=23.0",
    "ruff>=0.1",
]

[project.scripts]
{{ name }} = "{{ name | kebab_to_snake }}.server:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.black]
line-length = 100
target-version = ['py39']

[tool.ruff]
line-length = 100
target-version = "py39"
